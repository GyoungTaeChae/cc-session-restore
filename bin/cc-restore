#!/usr/bin/env bash
# cc-restore — reopen Claude Code sessions that are no longer running.
#   cc-restore            terminator closed (reboot): reopen the last snapshot right away.
#                         terminator open (a window was closed or crashed): pick from the
#                         sessions seen in the last day, the most recently lost ones ticked.
#                         Sessions go back into their saved windows, tabs and splits.
#   cc-restore --tabs     ignore the saved layout, one window with a tab per session
#   cc-restore --windows  ignore the saved layout, one window per session
#   cc-restore --list     print what would be offered, open nothing
#   cc-restore --notify   also report the result as a desktop notification
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

SNAPSHOT_DIR="${CLAUDE_SESSIONS_DIR:-@SESSIONS_DIR@}"
NOTIFY_ICON="cc-session-restore"

style="layout"
list_only="no"
notify="no"
for arg in "$@"; do
  case "$arg" in
    --list) list_only="yes" ;;
    --tabs) style="tabs" ;;
    --windows) style="windows" ;;
    --notify) notify="yes" ;;
    *) echo "usage: cc-restore [--tabs|--windows|--list] [--notify]" >&2; exit 1 ;;
  esac
done

send_notice() {
  [ "$notify" = "yes" ] || return 0
  command -v notify-send >/dev/null 2>&1 && notify-send -i "$NOTIFY_ICON" "Claude 세션" "$1"
  # notification banners may be turned off, so show a window too
  if [ "$(gsettings get org.gnome.desktop.notifications show-banners 2>/dev/null)" = "false" ] \
     && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="Claude 세션" --text="$1" --width=360 --timeout=8 >/dev/null 2>&1 || true
  fi
  return 0
}

echo "--- $(date '+%F %T') cc-restore $*"

terminator_running=0
pgrep -u "$USER" -x terminator >/dev/null && terminator_running=1

mapfile -t rows < <(cc-snapshot --print | cc-restore-layout candidates "$SNAPSHOT_DIR" "$terminator_running")
if [ "${#rows[@]}" -eq 0 ]; then
  echo "nothing to reopen: every recorded session is running"
  send_notice "다시 열 세션이 없습니다. 기록된 세션이 모두 실행 중입니다."
  exit 0
fi

if [ "$list_only" = "yes" ]; then
  printf '%-6s %-22s %-12s %s\n' "선택" "이름" "마지막 기록" "폴더"
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r preselected session_id session_name last_seen session_cwd <<<"$row"
    printf '%-6s %-22s %-12s %s\n' "$preselected" "$session_name" "$last_seen" "$session_cwd"
  done
  exit 0
fi

chosen_ids=()
if [ "$terminator_running" -eq 0 ]; then
  for row in "${rows[@]}"; do
    chosen_ids+=("$(cut -f2 <<<"$row")")
  done
else
  zenity_rows=()
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r preselected session_id session_name last_seen session_cwd <<<"$row"
    zenity_rows+=("$preselected" "$session_id" "$session_name" "$last_seen" "$session_cwd")
  done
  selection=$(zenity --list --checklist --title="Claude 세션 복원" \
    --text="다시 열 세션을 고르세요. 가장 최근에 닫힌 세션이 체크되어 있습니다." \
    --width=760 --height=420 --separator=" " --print-column=2 --hide-column=2 \
    --column="열기" --column="id" --column="이름" --column="마지막 기록" --column="폴더" \
    "${zenity_rows[@]}" 2>/dev/null) || { echo "cancelled"; exit 0; }
  read -r -a chosen_ids <<<"$selection"
fi

if [ "${#chosen_ids[@]}" -eq 0 ]; then
  echo "nothing chosen"
  exit 0
fi

if ! layout_used=$(cc-restore-layout build "$SNAPSHOT_DIR" "$style" "$terminator_running" "${chosen_ids[@]}"); then
  echo "could not build the restore layout"
  send_notice "복원 레이아웃을 만들지 못했습니다. 로그를 확인하세요."
  exit 1
fi
[ -n "$layout_used" ] && echo "following saved layout $layout_used"

# a running terminator would take the request over DBus and look for the layout in the
# config it loaded at startup, so start a separate process that reads the new config
if [ "$terminator_running" -eq 1 ]; then
  terminator -u -l claude_restore >/dev/null 2>&1 &
else
  terminator -l claude_restore >/dev/null 2>&1 &
fi

echo "opened ${#chosen_ids[@]} session(s): ${chosen_ids[*]}"
send_notice "${#chosen_ids[@]} 개 세션을 열었습니다."
